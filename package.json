{
  "name": "koishi-plugin-huaji-xiuxian",
  "version": "0.6.5-wechat.23",
  "description": "Koishi 群聊修仙扩展版，包含炼丹、世界 Boss、无尽塔与微信适配",
  "homepage": "https://github.com/sevenfate/koishi-plugin-xiuxian-wechat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sevenfate/koishi-plugin-xiuxian-wechat.git"
  },
  "bugs": {
    "url": "https://github.com/sevenfate/koishi-plugin-xiuxian-wechat/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "koishi",
    "plugin",
    "xiuxian",
    "wechat",
    "game",
    "mud"
  ],
  "contributors": [
    "huaji250 <945766041@qq.com>"
  ],
  "license": "MIT",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "data/xiuxian",
    "src",
    "patches",
    "scripts",
    "upstream.json",
    "README.md",
    "docs",
    "licenses",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "npm run build && npm run typecheck && npm test && npm run check:package",
    "check:package": "node scripts/check-package.cjs"
  },
  "devDependencies": {
    "@koishijs/core": "4.18.11",
    "@koishijs/plugin-database-postgres": "2.7.0",
    "@koishijs/plugin-database-sqlite": "4.7.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.23.1",
    "koishi": "4.18.11",
    "koishi-plugin-monetary": "0.1.3",
    "postgres": "^3.4.0",
    "tar": "^7.5.22",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-markdown-to-image-service": "^1.3.0 || ^2.7.0",
    "koishi-plugin-monetary": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-markdown-to-image-service": {
      "optional": true
    }
  },
  "koishi": {
    "description": {
      "zh": "群聊修仙文字 MUD，支持微信当前群昵称"
    },
    "service": {
      "required": [
        "database",
        "monetary"
      ],
      "optional": [
        "markdownToImage",
        "wechatRender",
        "assets"
      ]
    }
  }
}
